{% extends 'base.html.twig' %}

{% block title %}Modifier le Pin - Pinboard{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- TITRE -->
                    <div class="text-center mb-4">

                        <div class="fs-1 mb-2">
                            ✏️
                        </div>

                        <h1 class="fw-bold">
                            Modifier le Pin
                        </h1>

                        <p class="text-secondary">
                            Modifiez les informations de votre Pin.
                        </p>

                    </div>


                    <!-- IMAGE ACTUELLE -->
                    {% if pin.imageName %}

                        <div class="text-center mb-4">

                            <p class="fw-semibold mb-2">
                                Image actuelle
                            </p>

                            <img
                                src="{{ asset('uploads/pins/' ~ pin.imageName) }}"
                                alt="{{ pin.title }}"
                                class="img-fluid rounded-3"
                                style="max-height: 250px; object-fit: cover;"
                            >

                        </div>

                    {% endif %}


                    <!-- FORMULAIRE -->
                    <form method="post"
                          enctype="multipart/form-data">

                        <!-- TITRE -->
                        <div class="mb-3">

                            <label for="title"
                                   class="form-label fw-semibold">
                                Titre
                            </label>

                            <input
                                type="text"
                                id="title"
                                name="title"
                                class="form-control form-control-lg"
                                value="{{ pin.title }}"
                                required
                            >

                        </div>


                        <!-- DESCRIPTION -->
                        <div class="mb-3">

                            <label for="description"
                                   class="form-label fw-semibold">
                                Description
                            </label>

                            <textarea
                                id="description"
                                name="description"
                                class="form-control"
                                rows="5"
                                placeholder="Description du Pin..."
                            >{{ pin.description }}</textarea>

                        </div>


                        <!-- NOUVELLE IMAGE -->
                        <div class="mb-4">

                            <label for="image"
                                   class="form-label fw-semibold">
                                Nouvelle image
                            </label>

                            <input
                                type="file"
                                id="image"
                                name="image"
                                class="form-control form-control-lg"
                                accept="image/jpeg,image/png,image/webp"
                            >

                            <div class="form-text">
                                Laissez vide pour conserver l'image actuelle.
                                Formats acceptés : JPG, PNG et WEBP.
                            </div>

                        </div>


                        <!-- BOUTON -->
                        <div class="d-grid">

                            <button
                                type="submit"
                                class="btn btn-primary btn-lg">
                                💾 Modifier le Pin
                            </button>

                        </div>

                    </form>


                    <!-- RETOUR -->
                    <div class="text-center mt-4">

                        <a
                            href="{{ path('app_pin_show', {'id': pin.id}) }}"
                            class="text-decoration-none">
                            ← Retour au Pin
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}