{% extends 'base.html.twig' %}

{% block title %}Inscription - Pinboard{% endblock %}

{% block body %}

<div class="container">

    <div class="row justify-content-center py-5">

        <div class="col-md-7 col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- TITRE -->
                    <div class="text-center mb-4">

                        <div class="fs-1 mb-2">
                            📌
                        </div>

                        <h1 class="fw-bold">
                            Créer un compte
                        </h1>

                        <p class="text-secondary">
                            Rejoignez Pinboard et commencez à créer vos Pins.
                        </p>

                    </div>


                    <!-- FORMULAIRE -->
                    <form method="post">

                        <!-- PRÉNOM -->
                        <div class="mb-3">

                            <label for="firstname"
                                   class="form-label fw-semibold">
                                Prénom
                            </label>

                            <input
                                type="text"
                                id="firstname"
                                name="firstname"
                                class="form-control form-control-lg"
                                placeholder="Votre prénom"
                                required
                            >

                        </div>


                        <!-- NOM -->
                        <div class="mb-3">

                            <label for="lastname"
                                   class="form-label fw-semibold">
                                Nom
                            </label>

                            <input
                                type="text"
                                id="lastname"
                                name="lastname"
                                class="form-control form-control-lg"
                                placeholder="Votre nom"
                                required
                            >

                        </div>


                        <!-- EMAIL -->
                        <div class="mb-3">

                            <label for="email"
                                   class="form-label fw-semibold">
                                Adresse email
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="form-control form-control-lg"
                                placeholder="exemple@email.com"
                                autocomplete="email"
                                required
                            >

                        </div>


                        <!-- MOT DE PASSE -->
                        <div class="mb-3">

                            <label for="password"
                                   class="form-label fw-semibold">
                                Mot de passe
                            </label>

                            <input
                                type="password"
                                id="password"
                                name="password"
                                class="form-control form-control-lg"
                                placeholder="Votre mot de passe"
                                autocomplete="new-password"
                                required
                            >

                        </div>


                        <!-- IMAGE -->
                        <div class="mb-4">

                            <label for="imageName"
                                   class="form-label fw-semibold">
                                Nom de l'image
                            </label>

                            <input
                                type="text"
                                id="imageName"
                                name="imageName"
                                class="form-control form-control-lg"
                                placeholder="exemple.jpg"
                            >

                            <div class="form-text">
                                Vous pourrez ajouter votre photo de profil.
                            </div>

                        </div>


                        <!-- BOUTON -->
                        <div class="d-grid">

                            <button
                                type="submit"
                                class="btn btn-primary btn-lg">
                                S'inscrire
                            </button>

                        </div>

                    </form>


                    <!-- CONNEXION -->
                    <div class="text-center mt-4">

                        <span class="text-secondary">
                            Vous avez déjà un compte ?
                        </span>

                        <a href="{{ path('app_login') }}"
                           class="fw-semibold text-decoration-none">
                            Se connecter
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}